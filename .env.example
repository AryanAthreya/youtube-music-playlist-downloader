# ── Server Ports ──────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Download Limits ────────────────────────────────────────────────────────────
# Max simultaneous yt-dlp download workers (enforced via ThreadPoolExecutor)
MAX_CONCURRENT_DOWNLOADS=2

# Hours after which completed files are deleted by the retention sweep (0 = disabled, permanently kept)
DOWNLOAD_RETENTION_HOURS=0

# Minimum free disk space required before starting a download (MB)
MIN_DISK_HEADROOM_MB=1024

# ── Storage ────────────────────────────────────────────────────────────────────
# Path inside the backend container (matches Docker volume mount)
DOWNLOADS_BASE_PATH=/app/downloads

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the backend REST API
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL the browser uses for WebSocket connections
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
