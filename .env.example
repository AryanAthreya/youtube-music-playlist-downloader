# ── Production Domain & SSL (Behind Caddy) ──────────────────────────────────
# Set to your domain (e.g. mymusic.duckdns.org) for automatic HTTPS
DOMAIN=localhost

# Optional Basic Auth for private deployment:
# Generate hash via: docker run --rm caddy:2.9-alpine caddy hash-password --plaintext "mypassword"
AUTH_USER=admin
AUTH_HASH=

# ── Server Ports (Dev Mode) ───────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Concurrency & Streaming Limits ────────────────────────────────────────────
# Max simultaneous yt-dlp download workers
MAX_CONCURRENT_DOWNLOADS=2

# Max simultaneous real-time audio streams (prevents CPU starvation on 2 GB VMs)
MAX_CONCURRENT_STREAMS=3

# Hours after which completed files are deleted (0 = disabled, permanently kept)
DOWNLOAD_RETENTION_HOURS=0

# Hours after which stale temp streaming files are swept on startup
TEMP_CLEANUP_HOURS=24

# Minimum free disk space required before starting a download (MB)
MIN_DISK_HEADROOM_MB=1024

# ── YouTube Authentication (Optional Cookies) ─────────────────────────────────
# Mount a Netscape cookies.txt file to bypass YouTube bot detection / age limits
YTDLP_COOKIES_FILE=/app/cookies/cookies.txt
YTDLP_COOKIES_PATH=./cookies

# ── Storage ────────────────────────────────────────────────────────────────────
# Path inside the backend container (matches Docker volume mount)
DOWNLOADS_BASE_PATH=/app/downloads

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:3000

# ── Frontend (Dev Mode) ────────────────────────────────────────────────────────
# In production (docker-compose.prod.yml), these are passed as empty build args
# so the client uses same-origin relative URLs (/api/... and wss://host).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
